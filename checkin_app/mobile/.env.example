# Address of the backend server. On a real phone use your computer's LAN IP or the public URL.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# RevenueCat public SDK keys (RevenueCat > Project settings > API keys). Leave empty to hide purchases.
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxx
# Required by Apple on the purchase screen
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
