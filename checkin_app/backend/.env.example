# Copy to .env and fill in. Without the TWILIO_* values the server only logs calls and texts.
DATABASE_URL=sqlite:///./checkin.db
# Public HTTPS address of this server (Twilio must reach it). For local testing use ngrok.
PUBLIC_BASE_URL=https://your-server.example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100
VALIDATE_TWILIO_SIGNATURE=true
RUN_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=30

# In-app purchases (RevenueCat). Leave REQUIRE_SUBSCRIPTION=false while testing.
REQUIRE_SUBSCRIPTION=false
# RevenueCat > Project settings > API keys > Secret API key (starts with sk_)
REVENUECAT_API_KEY=
# The exact Authorization header value you enter on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTH=Bearer change-me-to-a-long-random-string
REVENUECAT_ENTITLEMENT=premium
